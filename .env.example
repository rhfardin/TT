# ---------- Required ----------
# Your domain, with https. Twilio/OpenAI/ElevenLabs reach the server here.
PUBLIC_URL=https://calls.yourdomain.com
# Same domain without https:// (used by Caddy to get the SSL certificate).
DOMAIN=calls.yourdomain.com
# Password for the dashboard.
ADMIN_PASSWORD=change-me-to-something-long

# Which voice AI to use: "openai" (pay as you go, no subscription) or "elevenlabs".
VOICE_PROVIDER=openai

# Twilio: the phone number the calls come from (needed for openai, and for SMS).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15551234567

# ---------- OpenAI (VOICE_PROVIDER=openai) ----------
OPENAI_API_KEY=
# gpt-realtime-mini = about $0.03/min (default). gpt-realtime = best quality, about 3x the price.
OPENAI_REALTIME_MODEL=gpt-realtime-mini
# Voices: marin, cedar (most natural), alloy, ash, ballad, coral, echo, sage, shimmer, verse
OPENAI_VOICE=marin
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini

# ---------- ElevenLabs (VOICE_PROVIDER=elevenlabs) ----------
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
# Secret the ElevenLabs agent tools send in the X-Tool-Secret header.
TOOL_SECRET=

# ---------- What the AI says about you ----------
AGENT_NAME=Alex
YOUR_NAME=
YOUR_COMPANY=
# e.g. "$499 one-time, then $49/month hosting". Leave empty and the AI won't quote a price.
OFFER_PRICE=
# Included in the follow-up email/text the AI sends during the call.
BOOKING_LINK=
PAYMENT_LINK=

# ---------- Follow-up email (strongly recommended) ----------
EMAIL_FROM="Your Name <you@yourdomain.com>"
# Option A: Resend (https://resend.com, free 3,000 emails/month). Works on Cloudflare too.
RESEND_API_KEY=
# Option B: SMTP (Node server only), e.g. smtp.gmail.com with an app password. Used only if Resend is not set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---------- Calling rules ----------
DEFAULT_COUNTRY_CODE=1
DEFAULT_TIMEZONE=America/New_York
CALL_WINDOW_START=9
CALL_WINDOW_END=17
# 1=Mon ... 7=Sun
CALL_DAYS=1,2,3,4,5
CALL_SPACING_SECONDS=90
MAX_ATTEMPTS=3
MAX_CALL_SECONDS=420
# Record calls in Twilio. Some states require everyone on the call to consent to recording.
RECORD_CALLS=false
# Hang up when nobody says anything for this many seconds (0 = never).
SILENCE_SECONDS=20
# Days off (YYYY-MM-DD, comma separated) and a 12-1 pm lunch break, on each business's own calendar.
NO_CALL_DATES=
LUNCH_BREAK=false
# Stop calling once the estimated spend of the last 24 hours reaches this many dollars (0 = no limit).
DAILY_SPEND_LIMIT=0
MAX_CALLS_PER_DAY=80

# ---------- Alerts ----------
ALERT_EMAIL=
# Morning summary email at this hour (in DEFAULT_TIMEZONE).
SUMMARY_EMAIL=false
SUMMARY_HOUR=8
# Hot leads are also POSTed here as JSON (e.g. a Zapier/Make catch hook). https only.
WEBHOOK_URL=

# Set to true only if this server sits behind Cloudflare's proxy (then the real visitor IP comes from
# CF-Connecting-IP, for the login limit). Leave false otherwise: that header could be faked.
BEHIND_CLOUDFLARE=false
