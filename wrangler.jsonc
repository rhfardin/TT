// Cloudflare Workers deployment. See "Deploy on Cloudflare (free)" in README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-caller",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public" },
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],

  // Create it with: npx wrangler d1 create ai-caller   (then paste the database_id here)
  "d1_databases": [
    { "binding": "DB", "database_name": "ai-caller", "database_id": "REPLACE_WITH_YOUR_DATABASE_ID" }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "CALLS", "class_name": "CallSession" },
      { "name": "DIALER", "class_name": "Dialer" }
    ]
  },
  // SQLite-backed Durable Objects are included in the Workers Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CallSession", "Dialer"] }],

  "triggers": { "crons": ["*/10 * * * *"] },

  // Non-secret settings. Put API keys and passwords in secrets instead:
  //   npx wrangler secret put ADMIN_PASSWORD   (and OPENAI_API_KEY, TWILIO_AUTH_TOKEN, RESEND_API_KEY, ...)
  "vars": {
    "VOICE_PROVIDER": "openai",
    "OPENAI_REALTIME_MODEL": "gpt-realtime-mini",
    "OPENAI_VOICE": "marin",
    "AGENT_NAME": "Alex",
    "YOUR_NAME": "Fardin",
    "YOUR_COMPANY": "Rizer Web",
    "OFFER_PRICE": "$750 for everything, including the first year of hosting",
    "BOOKING_LINK": "",
    "PAYMENT_LINK": "",
    "EMAIL_FROM": "Fardin <hello@rhfardin.com>",
    // What the AI knows about the offer (editable in Settings → "What the AI knows")
    "KB_ABOUT": "Fardin is an independent contractor, a web designer. He has been building websites for over 8 years and has made more than 800 sites for all kinds of local businesses. Portfolio: rhfardin.com. Besides websites, he also does SEO, Google Ads and social media marketing management. The main focus is great websites that build brand visibility and growth. If they ask about a company or business name: Fardin works under the name Rizer Web, a US company registered in Wyoming, and works remotely.",
    "KB_INCLUDED": "The new site already includes all the pages their current site has, and Fardin can add more pages if they want. It's fully mobile-friendly, and it can connect to any booking system or business tool they already use. Basic SEO is included. Hosting is free for the first year. The site and hosting are set up under the owner's own email, so they get full access.",
    "KB_PRICING": "$750 total, one full-package price: the site, setup, basic SEO and the first year of hosting. No monthly fee in the first year. They pay nothing until the site is live on their hosting; Fardin then sends his bank details for payment. If they push back on price, Fardin can come down, but only if they ask: first offer $700, and $650 is the absolute lowest. Never go below $650, and never offer a discount on your own.",
    "KB_TIMELINE": "Live within a week at most, because the site is already built.",
    "KB_PROCESS": "They don't need to send anything. They just tell Fardin anything they'd like changed on the new site. Fardin handles moving the domain and everything technical. After the site is live and they're happy, they pay.",
    "KB_GUARANTEE": "Typically 4 to 5 rounds of changes, whatever they need. The owner owns the domain, the site and the code; Fardin keeps nothing. After the first year the hosting stays on their own email, so they can just keep it going. Since the site is already made there's no money-back guarantee, but there is a satisfaction guarantee: Fardin doesn't get paid a single dime until the site is live on their hosting.",
    "KB_PROOF": "Past clients include USA West, SRS Networks, Web Services Now and Streamline Custom Solutions. Several past clients saw bookings go up a lot after their new site, around 50% and in some cases up to 100%. Owners also find a modern site builds customer trust and helps them show up better on Google and in AI search like ChatGPT.",
    "KB_FAQ": "Q: Can you add more pages? A: Yes, just tell Fardin what you need.\nQ: Will it work with our booking system? A: Yes, it can connect to any booking or business system.\nQ: Who owns the site? A: You do: the domain, the site and the code, all under your email.\nQ: What happens after the first year? A: Hosting stays on your own account, so you just keep it running.\nQ: Do you do Google Ads or marketing? A: Yes. Fardin also does SEO, Google Ads and social media management; Fardin can talk you through it.\nQ: Do I pay upfront? A: No. You pay nothing until the site is live.\nQ: How do I reach Fardin? A: Email hello@rhfardin.com, or book a quick call with him.\nQ: Where are you based? A: Fardin works remotely. His business, Rizer Web, is a US company registered in Wyoming.\nQ: Is this a company or one person? A: Fardin is an independent contractor; he works under the business name Rizer Web.",
    "KB_CLOSE": "Best outcome: they look at the preview and agree to go ahead, or to a quick call with Fardin. Send the preview with send_demo_link, and tell them they can reply to that email or write to hello@rhfardin.com. If they're keen to go ahead right away, tell them Fardin will email to get started and that payment only happens after the site is live. Don't read bank details over the phone.",
    "KB_NEVER": "Never promise Google rankings, a number of new customers, or specific results. Don't offer discounts unless they push on price, and never below $650. You can say a modern site typically builds customer trust and helps visibility on Google and in AI tools, and that past clients saw bookings rise.",
    "TWILIO_FROM_NUMBER": "",
    "DEFAULT_COUNTRY_CODE": "1",
    "DEFAULT_TIMEZONE": "America/New_York",
    "CALL_WINDOW_START": "9",
    "CALL_WINDOW_END": "17",
    "CALL_DAYS": "1,2,3,4,5",
    "CALL_SPACING_SECONDS": "90",
    "MAX_ATTEMPTS": "3",
    "MAX_CALL_SECONDS": "420"
  }
}
