// Cloudflare Workers deployment. See "Deploy on Cloudflare (free)" in README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-caller",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public" },
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],

  // Create it with: npx wrangler d1 create ai-caller   (then paste the database_id here)
  "d1_databases": [
    { "binding": "DB", "database_name": "ai-caller", "database_id": "REPLACE_WITH_YOUR_DATABASE_ID" }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "CALLS", "class_name": "CallSession" },
      { "name": "DIALER", "class_name": "Dialer" }
    ]
  },
  // SQLite-backed Durable Objects are included in the Workers Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CallSession", "Dialer"] }],

  "triggers": { "crons": ["*/10 * * * *"] },

  // Non-secret settings. Put API keys and passwords in secrets instead:
  //   npx wrangler secret put ADMIN_PASSWORD   (and OPENAI_API_KEY, TWILIO_AUTH_TOKEN, RESEND_API_KEY, ...)
  "vars": {
    "VOICE_PROVIDER": "openai",
    "OPENAI_REALTIME_MODEL": "gpt-realtime",
    "OPENAI_VOICE": "marin",
    "AGENT_NAME": "Alex",
    "YOUR_NAME": "",
    "YOUR_COMPANY": "",
    "OFFER_PRICE": "",
    "BOOKING_LINK": "",
    "PAYMENT_LINK": "",
    "EMAIL_FROM": "",
    "TWILIO_FROM_NUMBER": "",
    "DEFAULT_COUNTRY_CODE": "1",
    "DEFAULT_TIMEZONE": "America/New_York",
    "CALL_WINDOW_START": "9",
    "CALL_WINDOW_END": "17",
    "CALL_DAYS": "1,2,3,4,5",
    "CALL_SPACING_SECONDS": "90",
    "MAX_ATTEMPTS": "3",
    "MAX_CALL_SECONDS": "420"
  }
}
